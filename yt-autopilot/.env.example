# Copy to .env and fill in. Never commit .env or secrets/.

# Script writer: auto | claude | anthropic | ollama | offline
# auto uses the API if ANTHROPIC_API_KEY is set, else the Claude Code CLI, else Ollama.
CLAUDE_MODEL=
AI_MODE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_VISION_MODEL=llava:13b

# Voices
KOKORO_MODEL=models/kokoro-v1.0.onnx
KOKORO_VOICES=models/voices-v1.0.bin
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_UR=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Footage (free keys)
PEXELS_API_KEY=
PIXABAY_API_KEY=
AI_IMAGE_URL=
# Local AI images on an NVIDIA GPU (needs torch + diffusers): auto | none
AI_IMAGE_PROVIDER=auto
AI_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/token.json

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
